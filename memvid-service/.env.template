# MemVid Service Configuration

# Application Settings
APP_NAME=MemVid Service
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["*"]

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/memvid

# External Services
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION_NAME=memvid_vectors

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (add as needed)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_DIR=./uploads

# Video Processing Configuration
# MAX_VIDEO_DURATION=3600  # seconds
# SUPPORTED_VIDEO_FORMATS=["mp4", "avi", "mov", "mkv"]
