# Server configuration
PORT=3001

# Environment (development/production)
NODE_ENV=development

# URL for Qdrant vector database
# Use http://localhost:6333 for local development with docker-compose
# Use http://qdrant:6333 for internal docker communication
QDRANT_URL=http://localhost:6333

# Qdrant configuration
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=your_collection_name

# Google Gemini API key - used ONLY for embeddings (gemini-embedding-001, see GEMINI_VECTOR_SIZE).
# All text / vision generation runs on Alibaba Cloud Model Studio (DASHSCOPE_API_KEY, below).
GEMINI_API_KEY=your_api_key_here

# Vector size for embeddings
GEMINI_VECTOR_SIZE=768

# Google Cloud Vision API configuration
GOOGLE_CREDENTIALS_BASE64=your_api_key_here

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your_project_id

# Google Cloud Speech-to-Text Configuration
# Option 1: Use existing base64 credentials (RECOMMENDED - reuses existing setup)
# Just enable Speech-to-Text API in your Google Cloud project
# GOOGLE_CREDENTIALS_BASE64 is already configured above

# Option 2: Use separate key file (if you want different credentials)
# GOOGLE_CLOUD_KEY_FILE=path/to/your/service-account-key.json

# Option 3: Use application default credentials (for production)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Google Speech-to-Text V2 (Chirp) - used for Chinese audio (engine 'auto' or 'chirp').
# Same credentials/project as above; enable the Speech-to-Text API (V2 uses the same API).
# Any Chirp failure (permission, API not enabled, unsupported region/language) falls back to V1.
# GOOGLE_STT_V2_ENABLED=true            # 'false' disables Chirp completely (V1 only)
# GOOGLE_STT_V2_LOCATION=us             # chirp_3 is GA in the 'us' and 'eu' multi-regions
#                                       # (endpoint {location}-speech.googleapis.com)
# GOOGLE_STT_V2_MODEL=chirp_3           # chirp_2 needs us-central1 / europe-west4 / asia-southeast1
# GOOGLE_STT_V2_CONCURRENCY=3           # parallel sync Recognize calls per file (quota: 300/min/region)
# GOOGLE_STT_V2_ADAPTATION=boost        # phrase hints: boost | plain (no boost values) | off

# Alibaba Cloud Model Studio (DashScope, international / Singapore) speech recognition.
# Best measured engine for Mandarin TCM lectures (CER ~4-6% on real lectures vs ~20-37% for
# Google V1). Used for Chinese audio with engine 'auto' (see STT_CHINESE_ENGINE_ORDER) or 'alibaba'.
# Any failure falls back to the next engine. Keep the real key only in .env (git-ignored).
# DASHSCOPE_API_KEY=sk-...                    # Model Studio API key (Singapore region)
# ALIBABA_ASR_ENABLED=true                    # 'false' disables Alibaba ASR
# ALIBABA_ASR_BASE_URL=https://dashscope-intl.aliyuncs.com
#                                             # or the workspace endpoint
#                                             # https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
#                                             # (the legacy intl domain gets no new features after 2026-09-30)
# ALIBABA_ASR_MODEL=qwen3-asr-flash           # most verbatim (Chinese numerals, no hotword API; 60 s chunks)
#                                             # alternatives: qwen-audio-3.1-asr-flash-filetrans (whole file,
#                                             # timestamps, hotword vocabulary), fun-asr, qwen3-asr-flash-filetrans
# ALIBABA_ASR_SYNC_CHUNK_SECONDS=60           # chunk length for sync models (30-240)
# ALIBABA_ASR_CONCURRENCY=3                   # parallel sync requests per file
# ALIBABA_ASR_TIMEOUT_MS=                     # overall timeout; default 10 min + audio duration
# ALIBABA_ASR_GLOSSARY_WEIGHT=3               # TCM glossary hotword weight (1-5), vocabulary models only
# ALIBABA_ASR_HOTWORD_WEIGHT=4                # caller / board OCR hotword weight (1-5)
# ALIBABA_ASR_CONTEXT_GLOSSARY_TERMS=0        # glossary terms added to the qwen3-asr-flash context (0 = none)
# ALIBABA_ASR_CACHE_FILE=data/alibaba-vocabulary.json  # cached hotword vocabulary ids; a relative path
#                                             # resolves against the server/ directory (default server/data/...)
# STT_CHINESE_ENGINE_ORDER=alibaba,chirp,v1   # engine 'auto' order for Chinese audio (unavailable ones are skipped)

# Alibaba Cloud Model Studio (Qwen) text + vision generation (server/src/services/llm-client.ts).
# ALL generative steps run on Qwen (none use Gemini any more):
#   - documents: OCR text correction, page-boundary sentence completion, content enhancement,
#     chunk titles and summaries
#   - YouTube / lecture videos: transcript-based title / description / tag metadata, transcript
#     cleaning and translation, per-part titles and summaries, blackboard OCR (vision model)
#   - Chinese transcripts: domain-term (TCM) correction (quality model)
# Uses the same DASHSCOPE_API_KEY as Alibaba ASR above (also pass it to the container; see
# docker-compose.yml). Without the key (or with ALIBABA_LLM_ENABLED=false) these steps are skipped
# and the text is kept as is; video metadata generation falls back to the video's own metadata.
# "Thinking" mode is always disabled (enable_thinking:false). Embeddings stay on Gemini (GEMINI_API_KEY).
# ALIBABA_LLM_ENABLED=true                    # 'false' disables all LLM generation
# ALIBABA_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#                                             # default: the ALIBABA_ASR_BASE_URL origin + /compatible-mode/v1
# ALIBABA_LLM_FAST_MODEL=qwen3.8-flash        # titles, summaries, metadata, cleaning (1M context)
# ALIBABA_LLM_QUALITY_MODEL=qwen3.7-plus      # term correction, careful Vietnamese TCM wording
#                                             # (alternative: qwen3.8-max, ~5x the price)
# ALIBABA_LLM_VISION_MODEL=qwen3.8-flash      # blackboard / slide OCR (keeps the board's own script;
#                                             # alternative: qwen3.8-max). Avoid qwen3.7-plus / qwen3-vl-plus
#                                             # for OCR: they fill hidden text from their own knowledge
# ALIBABA_LLM_TIMEOUT_MS=120000               # per-request timeout
# ALIBABA_LLM_MAX_RETRIES=4                   # retries on 429 / 5xx / network errors (never on billing / 4xx)
# ALIBABA_LLM_MAX_INPUT_TOKENS=               # override the pre-flight context-window check (default per model)
# DISABLE_AI_APIS=false                       # 'true' skips Qwen page-boundary sentence completion in
#                                             # document ingestion (regex fallback). DISABLE_GEMINI_API is a
#                                             # deprecated alias for the same switch: despite its name it does
#                                             # not affect the Gemini embeddings.

# Blackboard OCR tuning (vision model above)
# BOARD_OCR_FRAME_WIDTH=1280                  # JPEG width sent to the model (480-3840)
# BOARD_OCR_FRAMES_PER_CALL=4                 # frames per request (1-10)
# BOARD_OCR_TIMEOUT_MS=                       # per-attempt timeout for OCR calls; default
#                                             # max(180000, ALIBABA_LLM_TIMEOUT_MS)

# Google OAuth2 client
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
SESSION_SECRET=some-strong-random-string

# OCR Configuration
MAX_FILE_SIZE_MB=10

# Audio Processing Requirements
# Ensure ffmpeg is installed and accessible in PATH for audio transcription
# Install: brew install ffmpeg (macOS) or apt-get install ffmpeg (Ubuntu)