{
  "name": "document-vector-storage-server",
  "version": "0.1.0",
  "description": "Server for document processing and vector storage",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register src/index.ts",
    "dev:debug": "ts-node -r tsconfig-paths/register --inspect src/index.ts",
    "migrate": "ts-node -r tsconfig-paths/register src/scripts/migrate.ts"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/speech": "^7.2.0",
    "@google-cloud/vision": "^4.3.3",
    "@google/genai": "^1.11.0",
    "@google/generative-ai": "^0.2.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "youtube-transcript": "^1.2.1",
    "youtube-transcript-api": "^1.1.2",
    "youtube-transcript-js-api": "^1.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.5",
    "@types/pdf-parse": "^1.1.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
